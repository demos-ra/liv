{
  "name": "@liv/substrate",
  "version": "0.1.0",
  "private": true,
  "description": "The LIV substrate — a standalone, live, append-only word-store. Typed writes in, raw reads out, with no LIV server present. The engine plugs in via the cognition seam; absent it, the store runs alone and the present recomposes on arrival.",
  "license": "UNLICENSED",
  "type": "commonjs",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test test/substrate.smoke.test.ts"
  },
  "dependencies": {
    "pg": "^8.19.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/pg": "^8.16.0",
    "tsx": "^4.19.0",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=18"
  }
}
