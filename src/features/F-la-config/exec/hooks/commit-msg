#!/bin/bash
# commit-msg — LIV Living Architecture validation
# Receives commit message file as $1

COMMIT_MSG_FILE="$1"
COMMIT_MSG=$(cat "$COMMIT_MSG_FILE")

# ─── Format check ─────────────────────────────────────────────────────────────
# Required: [F-{slice}/R{0-4}/C{1-5}] Description

PATTERN="^\[F-[a-z][a-z0-9-]*/R[0-4]/C[1-5]\]"

if ! echo "$COMMIT_MSG" | grep -qE "$PATTERN"; then
  echo ""
  echo "  Living Architecture ━━━━━━━━━━━━━━━━━━━━━━━━━━"
  echo ""
  echo "  ✗ BLOCKED: Invalid commit format"
  echo ""
  echo "  Required: [F-{slice}/R{0-4}/C{1-5}] Description"
  echo "  Example:  [F-identity/R1/C2] Add password validation"
  echo ""
  echo "  Change codes:"
  echo "    C1 — Internal refactor, no external change"
  echo "    C2 — New feature"
  echo "    C3 — API/contract change"
  echo "    C4 — R-layer reorganization"
  echo "    C5 — Migration / dependency update"
  echo ""
  echo "  ━━━━━━━━━━━━━━━━━━━━━━━━ Living Architecture"
  echo ""
  exit 1
fi

# ─── Extract slice and layer ──────────────────────────────────────────────────

SLICE=$(echo "$COMMIT_MSG" | grep -oE "F-[a-z][a-z0-9-]*")
LAYER=$(echo "$COMMIT_MSG" | grep -oE "/R[0-4]/" | tr -d '/')
C_CODE=$(echo "$COMMIT_MSG" | grep -oE "/C[1-5]\]" | tr -d '/]')

# ─── Validate slice is declared ───────────────────────────────────────────────

CONFIG="src/features/F-la-config/config/f-tags.json"

if [ -f "$CONFIG" ]; then
  if ! grep -q "\"$SLICE\"" "$CONFIG"; then
    echo ""
    echo "  Living Architecture ━━━━━━━━━━━━━━━━━━━━━━━━━━"
    echo ""
    echo "  ✗ BLOCKED: Undeclared slice: $SLICE"
    echo ""
    echo "  Add $SLICE to src/features/F-la-config/config/f-tags.json before building."
    echo ""
    echo "  ━━━━━━━━━━━━━━━━━━━━━━━━ Living Architecture"
    echo ""
    exit 1
  fi
fi

# ─── Pass ─────────────────────────────────────────────────────────────────────

echo ""
echo "  Living Architecture ━━━━━━━━━━━━━━━━━━━━━━━━━━"
echo ""
echo "  $COMMIT_MSG"
echo ""
echo "  Slice: $SLICE"
echo "  Layer: $LAYER"
echo "  Code:  $C_CODE"
echo ""
echo "  ✓ COMMIT ALLOWED"
echo ""
echo "  ━━━━━━━━━━━━━━━━━━━━━━━━ Living Architecture"
echo ""
exit 0
