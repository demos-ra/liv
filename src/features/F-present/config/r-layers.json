{
  "version": "2.1.0",
  "project": "liv",
  "enforcement_mode": "blocking",
  "layers": {
    "R0": {
      "name": "Config",
      "directory": "config",
      "required": false,
      "note": "Tokens, types, schemas, registries. Zero dependencies."
    },
    "R1": {
      "name": "Domain",
      "directory": "domain",
      "required": true,
      "note": "Pure logic and design primitives. Depends on R0 only."
    },
    "R2": {
      "name": "Application",
      "directory": "app",
      "required": false,
      "note": "Orchestration and server actions. Depends on R0, R1, R4 within slice. Cross-slice: R3 contract only."
    },
    "R3": {
      "name": "Contract",
      "directory": "contract",
      "required": true,
      "note": "API routes, tRPC routers, React hooks, UI components. Public boundary of each slice."
    },
    "R4": {
      "name": "Execution",
      "directory": "exec",
      "required": true,
      "note": "Postgres, git I/O, filesystem, external APIs. Depends on R0 and core/ only. Never imported cross-slice."
    }
  },
  "dependencies": {
    "R0": {
      "allowed": ["core", "R0_cross_slice"],
      "forbidden": ["R1", "R2", "R3", "R4"],
      "note": "R0 may import from core/types and other slices R0 only."
    },
    "R1": {
      "allowed": ["R0", "core"],
      "forbidden": ["R2", "R3", "R4"]
    },
    "R2": {
      "allowed": ["R0", "R1", "R4_same_slice", "R3_cross_slice", "core"],
      "forbidden": ["R3_same_slice", "R2_cross_slice", "R4_cross_slice"]
    },
    "R3": {
      "allowed": ["R0", "R1", "R2", "R3_cross_slice", "core"],
      "forbidden": ["R4_cross_slice"]
    },
    "R4": {
      "allowed": ["R0", "core"],
      "forbidden": ["R1", "R2", "R3", "R4_cross_slice"]
    }
  },
  "path_map": {
    "R0": "src/features/F-{slice}/config",
    "R1": "src/features/F-{slice}/domain",
    "R2": "src/features/F-{slice}/app",
    "R3": "src/features/F-{slice}/contract",
    "R4": "src/features/F-{slice}/exec",
    "core": "src/core"
  },
  "commit_format": {
    "pattern": "^\\[F-[a-z][a-z0-9-]*/R[0-4]/C[1-5]\\]",
    "example": "[F-identity/R1/C2] Add password validation"
  }
}
